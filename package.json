{
  "name": "learn-everything",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "type": "module",
  "license": "UNLICENSED",
  "description": "lernu.cc root-domain portal — index and entry point to the lernu.cc learning projects.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:auth": "tsx scripts/lint/check-auth.ts",
    "lint:max-lines": "tsx scripts/lint/check-file-length.ts",
    "lint:i18n": "tsx scripts/lint/find-unused-i18n-keys.ts --check",
    "lint:auth-schema-drift": "tsx scripts/lint/check-auth-schema-drift.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:push-safe": "tsx scripts/lint/check-auth-schema-drift.ts && prisma db push",
    "prepare": "husky",
    "preinstall": "git config --local url.\"https://github.com/GoddoNebianU/design-system\".insteadOf \"git@github.com:GoddoNebianU/design-system\" 2>/dev/null || true"
  },
  "dependencies": {
    "@goddonebianu/design-system": "github:GoddoNebianU/design-system#main",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "jose": "^6.2.3",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "next-intl": "^4.9.1",
    "nodemailer": "^8.0.5",
    "pg": "^8.20.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.5.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@tailwindcss/postcss": "^4.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.12.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^7.7.0",
    "tailwindcss": "^4.2.3",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint",
    "*.{ts,tsx,css,json,md}": "prettier --check"
  }
}
